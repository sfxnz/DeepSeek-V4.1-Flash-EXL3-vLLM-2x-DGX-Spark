# review-e14: canonical-e13 + widen_p2b_coop.py (DSV41_P2B_COOP, default off).
# Rebuilds only vllm_exl3_c, from the same vllm-exl3 pin and the same p2b chain
# as docker/Dockerfile.e13, plus the coop stage. With the env unset the SORT=0/1
# kernels are byte-identical to canonical-e13's chain
# (kernel_study/p2b_coop/sass_identity.sh); coop adds p2b_moe_batched_kernel<2, 1, 2>.
#   docker build -f docker/Dockerfile.e14 -t dsv41-flash-exl3-sm121:review-e14 docker
FROM dsv41-flash-exl3-sm121:canonical-e13

COPY patch /opt/dsv41-patch

# Same pin as docker/Dockerfile.e13
ARG VLLM_EXL3_REF=d3cfd394920360d69f820d2dc96f8292a9e10283
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && git clone https://github.com/vcruz305/vllm-exl3.git /opt/vllm-exl3 \
 && git -C /opt/vllm-exl3 checkout "$VLLM_EXL3_REF" \
 && python3 /opt/dsv41-patch/fix_vllm_exl3_setup.py /opt/vllm-exl3/setup.py \
 && python3 /opt/dsv41-patch/widen_p2b_shapes.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_mrow.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_cfg1.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_codebook.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_fshift.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_srcsort.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_coop.py /opt/vllm-exl3 \
 && TORCH_CUDA_ARCH_LIST=12.1a python3 -m pip install --no-build-isolation --no-deps --force-reinstall /opt/vllm-exl3 \
 && python3 -c "import torch, vllm_exl3, vllm_exl3_c; so = open(vllm_exl3_c.__file__, 'rb').read(); assert hasattr(vllm_exl3_c, 'p2b_fused_moe'); assert b'DSV41_P2B_SRC_SORT' in so and b'DSV41_P2B_COOP' in so; print('vllm_exl3 coop cuda ok')" \
 && rm -rf /opt/vllm-exl3 /var/lib/apt/lists/*
LABEL dsv41.recipe.patches="shapes,mrow,cfg1,codebook,fshift,srcsort,coop,b12x_smalls,fix_o_proj_woa_fp8,woa_prepack"
