# Experiment image: p2b mma-over-m rows, full chain incl. widen_p2b_mma.
# Derived from the recipe image so exllamav3 and the base patches are reused.
# Chain order matters: mma was authored after mrow and before cfg1.
# Decode regresses on this image (known: L.A.I.L ~10.8); measure PREFILL only.
FROM dsv41-flash-exl3-sm121

# The base image's patch snapshot predates widen_p2b_codebook.py; refresh it.
COPY patch /opt/dsv41-patch

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git libcusparse-dev-13-0 libcusolver-dev-13-0 \
 && git clone https://github.com/vcruz305/vllm-exl3.git /opt/vllm-exl3 \
 && git -C /opt/vllm-exl3 checkout d3cfd394920360d69f820d2dc96f8292a9e10283 \
 && python3 /opt/dsv41-patch/fix_vllm_exl3_setup.py /opt/vllm-exl3/setup.py \
 && python3 /opt/dsv41-patch/widen_p2b_shapes.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_mrow.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_mma.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_cfg1.py /opt/vllm-exl3 \
 && python3 /opt/dsv41-patch/widen_p2b_codebook.py /opt/vllm-exl3 \
 && TORCH_CUDA_ARCH_LIST=12.1a python3 -m pip install --no-build-isolation --no-deps /opt/vllm-exl3 \
 && python3 -c "import vllm_exl3_c; assert hasattr(vllm_exl3_c, 'p2b_fused_moe'); print('mma build ok')" \
 && rm -rf /opt/vllm-exl3 /var/lib/apt/lists/*
