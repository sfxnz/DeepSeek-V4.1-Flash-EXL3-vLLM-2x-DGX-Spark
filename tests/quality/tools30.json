   "tools": [
    "search_flights",
    "book_restaurant"
   ],
   "expect": {
    "name": "search_flights",
    "args": {
     "origin": "SFO",
     "destination": "JFK",
     "date": "2026-11-12",
     "passengers": 2,
     "cabin": "business"
    }
   }
  },
  {
