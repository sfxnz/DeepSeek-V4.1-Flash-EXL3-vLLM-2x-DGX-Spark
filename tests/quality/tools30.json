{
 "tools": {
  "get_weather": {
   "type": "function",
   "function": {
    "name": "get_weather",
    "description": "Get current weather for a city",
    "parameters": {
     "type": "object",
     "properties": {
      "city": {
       "type": "string"
      },
      "unit": {
       "type": "string",
       "enum": [
        "c",
        "f"
       ]
      }
     },
     "required": [
      "city"
     ]
    }
   }
  },
  "convert_currency": {
   "type": "function",
   "function": {
    "name": "convert_currency",
    "description": "Convert an amount between currencies (ISO 4217 codes)",
    "parameters": {
     "type": "object",
     "properties": {
      "amount": {
       "type": "number"
      },
      "from": {
       "type": "string",
       "description": "ISO 4217 code"
      },
      "to": {
       "type": "string",
       "description": "ISO 4217 code"
      }
     },
     "required": [
      "amount",
      "from",
      "to"
     ]
    }
   }
  },
  "create_calendar_event": {
   "type": "function",
   "function": {
    "name": "create_calendar_event",
    "description": "Create a calendar event",
    "parameters": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string"
      },
      "date": {
       "type": "string",
       "description": "YYYY-MM-DD"
      },
      "start_time": {
       "type": "string",
       "description": "HH:MM, 24-hour"
      },
      "duration_minutes": {
       "type": "integer"
      },
      "attendees": {
       "type": "array",
       "items": {
        "type": "string",
        "description": "email"
       }
      }
     },
     "required": [
      "title",
      "date",
      "start_time",
      "duration_minutes"
     ]
    }
   }
  },
  "search_flights": {
   "type": "function",
   "function": {
    "name": "search_flights",
    "description": "Search flights between airports (IATA codes)",
    "parameters": {
     "type": "object",
     "properties": {
      "origin": {
       "type": "string"
      },
      "destination": {
       "type": "string"
      },
      "date": {
       "type": "string",
       "description": "YYYY-MM-DD"
      },
      "passengers": {
       "type": "integer"
      },
      "cabin": {
       "type": "string",
       "enum": [
        "economy",
        "business",
        "first"
       ]
      }
     },
     "required": [
      "origin",
      "destination",
      "date",
      "passengers",
      "cabin"
     ]
    }
   }
  },
  "set_thermostat": {
   "type": "function",
   "function": {
    "name": "set_thermostat",
    "description": "Set the home thermostat (degrees Celsius)",
    "parameters": {
     "type": "object",
     "properties": {
      "temperature": {
       "type": "number"
      },
      "mode": {
       "type": "string",
       "enum": [
        "heat",
        "cool",
        "auto"
       ]
      }
     },
     "required": [
      "temperature",
      "mode"
     ]
    }
   }
  },
  "send_email": {
   "type": "function",
   "function": {
    "name": "send_email",
    "description": "Send an email",
    "parameters": {
     "type": "object",
     "properties": {
      "to": {
       "type": "string"
      },
      "subject": {
       "type": "string"
      },
      "body": {
       "type": "string"
      }
     },
     "required": [
      "to",
      "subject",
      "body"
     ]
    }
   }
  },
  "add_todo": {
   "type": "function",
   "function": {
    "name": "add_todo",
    "description": "Add a todo item",
    "parameters": {
     "type": "object",
     "properties": {
      "task": {
       "type": "string"
      },
      "priority": {
       "type": "string",
       "enum": [
        "low",
        "medium",
        "high"
       ]
      },
      "tags": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "required": [
      "task",
      "priority"
     ]
    }
   }
  },
  "lookup_stock_price": {
   "type": "function",
   "function": {
    "name": "lookup_stock_price",
    "description": "Get the latest price for a stock ticker",
    "parameters": {
     "type": "object",
     "properties": {
      "ticker": {
       "type": "string"
      }
     },
     "required": [
      "ticker"
     ]
    }
   }
  },
  "calculate_loan_payment": {
   "type": "function",
   "function": {
    "name": "calculate_loan_payment",
    "description": "Monthly payment for a fixed-rate loan",
    "parameters": {
     "type": "object",
     "properties": {
      "principal": {
       "type": "number"
      },
      "annual_rate_percent": {
       "type": "number"
      },
      "years": {
       "type": "integer"
      }
     },
     "required": [
      "principal",
      "annual_rate_percent",
      "years"
     ]
    }
   }
  },
  "update_user_profile": {
   "type": "function",
   "function": {
    "name": "update_user_profile",
    "description": "Update a user's settings",
    "parameters": {
     "type": "object",
     "properties": {
      "user_id": {
       "type": "integer"
      },
      "settings": {
       "type": "object",
       "properties": {
        "newsletter": {
         "type": "boolean"
        },
        "language": {
         "type": "string",
         "description": "ISO 639-1 code"
        }
       },
       "required": []
      }
     },
     "required": [
      "user_id",
      "settings"
     ]
    }
   }
  },
  "translate_text": {
   "type": "function",
   "function": {
    "name": "translate_text",
    "description": "Translate text",
    "parameters": {
     "type": "object",
     "properties": {
      "text": {
       "type": "string"
      },
      "target_language": {
       "type": "string",
       "description": "ISO 639-1 code"
      }
     },
     "required": [
      "text",
      "target_language"
     ]
    }
   }
  },
  "book_restaurant": {
   "type": "function",
   "function": {
    "name": "book_restaurant",
    "description": "Book a restaurant table",
    "parameters": {
     "type": "object",
     "properties": {
      "restaurant": {
       "type": "string"
      },
      "party_size": {
       "type": "integer"
      },
      "date": {
       "type": "string",
       "description": "YYYY-MM-DD"
      },
      "time": {
       "type": "string",
       "description": "HH:MM, 24-hour"
      }
     },
     "required": [
      "restaurant",
      "party_size",
      "date",
      "time"
     ]
    }
   }
  },
  "get_directions": {
   "type": "function",
   "function": {
    "name": "get_directions",
    "description": "Directions between two places",
    "parameters": {
     "type": "object",
     "properties": {
      "from": {
       "type": "string"
      },
      "to": {
       "type": "string"
      },
      "mode": {
       "type": "string",
       "enum": [
        "driving",
        "walking",
        "transit",
        "cycling"
       ]
      }
     },
     "required": [
      "from",
      "to",
      "mode"
     ]
    }
   }
  },
  "set_timer": {
   "type": "function",
   "function": {
    "name": "set_timer",
    "description": "Start a countdown timer",
    "parameters": {
     "type": "object",
     "properties": {
      "minutes": {
       "type": "integer"
      },
      "label": {
       "type": "string"
      }
     },
     "required": [
      "minutes"
     ]
    }
   }
  },
  "query_database": {
   "type": "function",
   "function": {
    "name": "query_database",
    "description": "Query a table with filters",
    "parameters": {
     "type": "object",
     "properties": {
      "table": {
       "type": "string"
      },
      "filters": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "field": {
          "type": "string"
         },
         "op": {
          "type": "string",
          "enum": [
           "eq",
           "neq",
           "gt",
           "lt",
           "gte",
           "lte"
          ]
         },
         "value": {
          "type": [
           "string",
           "number"
          ]
         }
        },
        "required": [
         "field",
         "op",
         "value"
        ]
       }
      },
      "limit": {
       "type": "integer"
      }
     },
     "required": [
      "table",
      "filters"
     ]
    }
   }
  },
  "resize_image": {
   "type": "function",
   "function": {
    "name": "resize_image",
    "description": "Resize an image",
    "parameters": {
     "type": "object",
     "properties": {
      "image_id": {
       "type": "string"
      },
      "width": {
       "type": "integer"
      },
      "height": {
       "type": "integer"
      },
      "keep_aspect": {
       "type": "boolean"
      }
     },
     "required": [
      "image_id",
      "width",
      "height",
      "keep_aspect"
     ]
    }
   }
  }
 },
 "items": [
  {
   "id": "t01",
   "prompt": "What's the weather in Tokyo in Celsius?",
   "tools": [
    "get_weather",
    "lookup_stock_price"
   ],
   "expect": {
    "name": "get_weather",
    "args": {
     "city": "Tokyo",
     "unit": "c"
    }
   }
  },
  {
   "id": "t02",
   "prompt": "Convert 250 USD to EUR.",
   "tools": [
    "convert_currency"
   ],
   "expect": {
    "name": "convert_currency",
    "args": {
     "amount": 250,
     "from": "USD",
     "to": "EUR"
    }
   }
  },
  {
   "id": "t03",
   "prompt": "Create a calendar event titled 'Design review' on 2026-10-05 at 14:30 for 45 minutes with attendees alice@example.com and bob@example.com.",
   "tools": [
    "create_calendar_event",
    "send_email"
   ],
   "expect": {
    "name": "create_calendar_event",
    "args": {
     "title": "Design review",
     "date": "2026-10-05",
     "start_time": "14:30",
     "duration_minutes": 45,
     "attendees": [
      "alice@example.com",
      "bob@example.com"
     ]
    }
   }
  },
  {
   "id": "t04",
