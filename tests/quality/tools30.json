     "mode": "heat"
    }
   }
  },
  {
   "id": "t06",
   "prompt": "Send an email to carol@example.com with subject 'Quarterly report' telling her the report is attached.",
   "tools": [
    "send_email",
    "add_todo"
   ],
   "expect": {
    "name": "send_email",
    "args": {
     "to": "carol@example.com",
     "subject": "Quarterly report"
    }
   },
   "ignore": [
    "body"
   ]
  },
  {
   "id": "t07",
   "prompt": "Add a high priority todo 'Renew passport' tagged 'personal' and 'travel'.",
